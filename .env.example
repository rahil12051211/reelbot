# Captions: Anthropic first, Grok (xAI) fallback, else heuristic
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# Instagram option A: username/password (used if both set)
IG_USERNAME=
IG_PASSWORD=
# set only if 2FA is on (current 6-digit code)
IG_2FA_CODE=

# Instagram option B: official Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
